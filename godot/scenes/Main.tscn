[node name="HelpLabel" type="Label" parent="HelpModal/MarginContainer" unique_id=195571608]
layout_mode = 2
text = "Controls
A / D — Select left / right hand
Q — Shake (pump -1)
E — Chalk (grip reset)
1 — Reach style
2 — Regular style
3 — Cross style
Z / X / C — Weight left / center / right
R — Commit (skill)
T — Dyno (skill)
F1 — Camp
ESC — Return to world map
TAB — Toggle this help"
